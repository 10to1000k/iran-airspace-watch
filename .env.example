# ── تلگرام (الزامی) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# اگر خالی باشد، با اولین /start در بات پر می‌شود
TELEGRAM_CHAT_ID=

# ── ترجمه (الزامی) — هر سرویس سازگار با OpenAI ────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# مدل‌های جانشین با کاما. اگر مدل اصلی شلوغ (503) یا حذف‌شده (404) بود، به ترتیب امتحان می‌شوند.
LLM_FALLBACK_MODELS=

# ── NOTAM (اختیاری ولی توصیه‌شده) ─────────────────────────────
# ثبت‌نام در پورتال API: https://api.faa.gov
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# ── OpenSky برای ساخت لیست زنده‌ی ایرلاین‌ها (اختیاری) ─────────
OPENSKY_USER=
OPENSKY_PASS=

# ── کانال‌های تلگرام (اختیاری) ────────────────────────────────
ENABLE_TELEGRAM_CHANNELS=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram

# ── توییتر (اختیاری، ریسک ToS) ───────────────────────────────
ENABLE_X=false
# فرمت: user:pass:email:pass,user2:pass2:email2:pass2
X_ACCOUNTS=

# ── عمومی ────────────────────────────────────────────────────
LOG_LEVEL=INFO

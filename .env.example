# ── تلگرام (الزامی) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# اختیاری؛ اگر خالی باشد، نام کاربری با getMe از Bot API شناسایی می‌شود.
TELEGRAM_BOT_USERNAME=
# اگر خالی باشد، با اولین /start معمولی در بات پر می‌شود (deep-link چت این مقدار را تغییر نمی‌دهد).
TELEGRAM_CHAT_ID=

# ── ترجمه (الزامی برای خبرهای غیر فارسی) — هر سرویس سازگار با OpenAI ─
# اگر ترجمه در دسترس نباشد، خبر غیرفارسی منتشر نمی‌شود تا متن اصلی به‌جای فارسی نرود.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# مدل‌های جانشین با کاما. اگر مدل اصلی شلوغ (503) یا حذف‌شده (404) بود، به ترتیب امتحان می‌شوند.
LLM_FALLBACK_MODELS=

# ── NOTAM (اختیاری ولی توصیه‌شده) ─────────────────────────────
# ثبت‌نام در پورتال API: https://api.faa.gov
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# ── OpenSky برای ساخت لیست زنده‌ی ایرلاین‌ها (اختیاری) ─────────
OPENSKY_USER=
OPENSKY_PASS=

# ── رصد کانال‌های تلگرام ─────────────────────────────────────
# پیش‌نمایش عمومی t.me/s بدون نیاز به ادمین/توکن ورودی؛ فقط کانال‌های عمومی.
# وابسته به HTML عمومی تلگرام است و ممکن است با تغییر سایت یا rate limit موقتاً قطع شود.
ENABLE_TELEGRAM_PUBLIC_PREVIEW=true
# مسیر رسمی Bot API فقط برای کانال‌هایی که بات در آن‌ها ادمین شده است.
ENABLE_TELEGRAM_CHANNELS=false
# نام‌های اضافی برای هر دو مسیر، با کاما و بدون @؛ فهرست اصلی در config/sources.yaml است.
TELEGRAM_CHANNELS=

# ── جست‌وجوی رسمی X API v2 (اختیاری؛ نیازمند دسترسی recent search) ─
ENABLE_X=false
X_BEARER_TOKEN=

# ── عمومی ────────────────────────────────────────────────────
LOG_LEVEL=INFO

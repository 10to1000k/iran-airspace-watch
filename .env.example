# ── تلگرام (الزامی) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# اختیاری: شناسه‌ی عددی گیرنده‌ی ثابت (چند نفر با کاما). اگر خالی باشد،
# هر کس در بات /start بزند مشترک می‌شود و خبر برای همه‌ی مشترک‌ها می‌رود؛
# لغو اشتراک با /stop است.
TELEGRAM_CHAT_ID=

# ── ترجمه — زنجیره‌ی رایگان (توصیه‌شده) ────────────────────────
# سرویس‌ها خودکار و به‌ترتیب امتحان می‌شوند: Gemini ← Groq ← OpenRouter.
# هرکدام را که کلیدش را داری پر کن؛ بقیه را خالی بگذار (از زنجیره حذف می‌شوند).
# اگر یکی سقف سهمیه‌ی روزانه (429) بخورد، شلوغ (503) باشد یا کلیدش رد شود
# (401/403)، ترجمه خودکار با سرویس بعدی ادامه پیدا می‌کند.
#   Gemini:      https://aistudio.google.com/apikey   (بدون کارت بانکی)
#   Groq:        https://console.groq.com
#   OpenRouter:  https://openrouter.ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# مدل‌های جانشین هر سرویس با کاما (اختیاری؛ پیش‌فرض‌ها در کد هست):
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free

# ── ترجمه — سرویس تکیِ دلخواه (قدیمی، اختیاری) ─────────────────
# هر سرویس سازگار با OpenAI. اگر ست شود، در انتهای زنجیره‌ی بالا قرار می‌گیرد.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# مدل‌های جانشین با کاما. اگر مدل اصلی شلوغ (503) یا حذف‌شده (404) بود، به ترتیب امتحان می‌شوند.
LLM_FALLBACK_MODELS=

# ── NOTAM (اختیاری ولی توصیه‌شده) ─────────────────────────────
# ثبت‌نام در پورتال API: https://api.faa.gov
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# ── OpenSky برای ساخت لیست زنده‌ی ایرلاین‌ها (اختیاری) ─────────
OPENSKY_USER=
OPENSKY_PASS=

# ── کانال‌های تلگرام (اختیاری) ────────────────────────────────
ENABLE_TELEGRAM_CHANNELS=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram

# ── توییتر (اختیاری، ریسک ToS) ───────────────────────────────
ENABLE_X=false
# فرمت: user:pass:email:pass,user2:pass2:email2:pass2
X_ACCOUNTS=

# ── عمومی ────────────────────────────────────────────────────
LOG_LEVEL=INFO
